# 75-napi-mac.rules - assign MAC addresses from the NAPI EEPROM
#
# 1. Every "add" of a physical network interface: initial boot enumeration,
#    USB hotplug and USB re-enumeration after a bus reset (smsc95xx generates a
#    new random MAC on every probe, so the address must be re-applied each time).
#    The helper gets IFINDEX, not the name: $name and $env{INTERFACE} are
#    substituted when this line is parsed, before NAME= from later rules
#    (e.g. 99-*-net-names.rules, 80-net-setup-link.rules) is applied, so on
#    hotplug the helper would get the stale kernel name ("eth0"). The index
#    survives renaming; the helper resolves the final name when it runs.
#    RUN programs complete before the event is published to
#    NetworkManager/networkd, so they see the interface with the correct MAC.
#
# 2. The EEPROM driver (at24) binding to 1-0050. If the EEPROM appears after
#    the network interfaces (at24 as a late module), their "add" events found
#    no EEPROM and were deferred (exit code 4); this pass handles them.
#    The bus/address must match the EEPROM path in napi-set-mac.
#
# 3. The USB Ethernet driver binding to its USB interface. udev drops the
#    whole "add" event of a network interface whose rename fails (two USB
#    adapters on different controllers getting the same predictable name,
#    "Failed to rename ... File exists"), so rule 1 never runs for it; if the
#    adapter appears after the at24 pass and the boot service, nothing else
#    would set its MAC. The "bind" event comes after the driver has registered
#    the network interface and does not depend on its name. Add other drivers
#    here if mac.conf uses them ("driver" key).
#
# Debian/Armbian copy this file into the initramfs, where the helper is not
# present; TEST makes the rules a no-op there instead of failing RUN.

ACTION=="add", SUBSYSTEM=="net", KERNEL!="lo", TEST=="/usr/lib/udev/napi-set-mac", \
	ENV{DEVTYPE}!="bridge", ENV{DEVTYPE}!="vlan", ENV{DEVTYPE}!="bond", ENV{DEVTYPE}!="wlan", \
	RUN+="/usr/lib/udev/napi-set-mac --ifindex $env{IFINDEX}"

ACTION=="bind", SUBSYSTEM=="i2c", KERNEL=="1-0050", DRIVER=="at24", TEST=="/usr/lib/udev/napi-set-mac", \
	RUN+="/usr/lib/udev/napi-set-mac --all"

ACTION=="bind", SUBSYSTEM=="usb", DRIVER=="smsc95xx", TEST=="/usr/lib/udev/napi-set-mac", \
	RUN+="/usr/lib/udev/napi-set-mac --all"
