# 75-napi-mac.rules - assign MAC addresses from the NAPI EEPROM
#
# Runs on every "add" of a physical network interface: initial boot enumeration,
# USB hotplug and USB re-enumeration after a bus reset (smsc95xx generates a new
# random MAC on every probe, so the address must be re-applied each time).
# The number 75 puts it after systemd's 71-seat/73-usb rules and after
# net_setup_link (interface renaming), so $env{INTERFACE} is the final name.
# RUN programs execute after all rules, before the event is published to
# NetworkManager/networkd, so they see the interface with the correct MAC.

ACTION=="add", SUBSYSTEM=="net", KERNEL!="lo", \
	ENV{DEVTYPE}!="bridge", ENV{DEVTYPE}!="vlan", ENV{DEVTYPE}!="bond", ENV{DEVTYPE}!="wlan", \
	RUN+="/usr/lib/udev/napi-set-mac $env{INTERFACE}"
