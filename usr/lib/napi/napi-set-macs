#!/bin/sh
#
#  __MODULE__	napi-set-macs
#  __IDENT__	V11-000
#  __REV__	11.0
#
#  Abstract:	Remedial pass over all existing network interfaces. Since v11 the
#		primary mechanism is the udev rule 75-napi-mac.rules; this script
#		is run by napi-mac.service at boot as a safety net and can be
#		re-run manually after editing /etc/napi/mac.conf.
#
#  Exit codes:	0  no errors
#		1  at least one interface reported an error
#
#  Modification history:
#	11.0	24-SEP-2026	Version bump, no functional change.
#	10.0	24-SEP-2026	Error counting and summary; non-zero exit on failure.
#

EEPROM=/sys/bus/i2c/devices/1-0050/eeprom
SETMAC=/usr/lib/udev/napi-set-mac

l_ok=0
l_skip=0
l_err=0

if [ ! -e "$EEPROM" ]; then
	echo "napi-mac: SKIPPED - EEPROM not available"
	exit 0
fi

for l_path in /sys/class/net/*; do
	l_iface=$(basename "$l_path")
	[ "$l_iface" = "lo" ] && continue
	"$SETMAC" "$l_iface"
	case $? in
	0) l_ok=$((l_ok + 1)) ;;
	3) l_skip=$((l_skip + 1)) ;;
	*) l_err=$((l_err + 1)) ;;
	esac
done

echo "napi-mac: pass complete: set/already=$l_ok not-managed=$l_skip errors=$l_err"
[ "$l_err" -eq 0 ]
