[Unit]
Description=Set MACs from NAPI EEPROM (remedial pass)
Documentation=file:/etc/napi/mac.conf
# Primary mechanism is the udev rule 75-napi-mac.rules (net "add" and EEPROM
# "bind" events); this pass only covers interfaces that existed before the
# rule was installed or whose udev event failed (e.g. a failed rename).
# No udev-settle: it is deprecated and does not wait for USB devices that the
# USB core has not discovered yet.
After=systemd-udevd.service
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/lib/udev/napi-set-mac --all
RemainAfterExit=yes
# Fail-open: a broken EEPROM must not block boot.
SuccessExitStatus=1

[Install]
WantedBy=multi-user.target
